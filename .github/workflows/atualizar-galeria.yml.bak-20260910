name: Atualizar galeria via Google Drive

on:
  schedule:
    - cron: '0 12 * * 1'
  workflow_dispatch:

jobs:
  atualizar:
    runs-on: ubuntu-latest

    steps:
      - name: Baixar repositório
        uses: actions/checkout@v4

      - name: Instalar Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Instalar dependências
        run: pip install requests

      - name: Atualizar páginas do portfólio
        env:
          GOOGLE_API_KEY: ${{ secrets.GOOGLE_API_KEY }}
        run: python atualizar-site.py

      - name: Salvar páginas atualizadas
        run: |
          git config user.name  "Bot do site"
          git config user.email "bot@douglasnschimidt.com"
          git add portfolio.html portfolio-en.html
          git add -u categoria-*.html loja.html 2>/dev/null || true
          git diff --staged --quiet || git commit -m "Portfólio atualizado via Google Drive"
          git push

      - name: Publicar no Netlify
        env:
          NETLIFY_TOKEN: ${{ secrets.NETLIFY_TOKEN }}
        run: |
          curl -s -X POST "https://api.netlify.com/api/v1/sites/harmonious-crisp-ede73f/deploys" \
            -H "Authorization: Bearer $NETLIFY_TOKEN" \
            -H "Content-Type: application/zip" \
            --data-binary @<(cd . && zip -r - . -x "*.git*" "*.github*" "*.py" "*.yml" "*.md") \
            | grep -o '"state":"[^"]*"' | head -1
