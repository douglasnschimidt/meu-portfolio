/* ════════════════════════════════════════════════════════════
   FONTE PERSONALIZADA — caligrafia do Douglas
   O arquivo LapisDeArtista-Regular.ttf deve estar na raiz do site
   ════════════════════════════════════════════════════════════ */
@font-face {
  font-family: 'LapisDeArtista';
  src: url('DnsLetraDeArtista-Regular.woff2') format('woff2');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}

/* ════════════════════════════════════════════════════════════
   VARIÁVEIS — edite aqui para mudar cores e fontes do site inteiro
   (Este arquivo controla a aparência de todas as páginas de uma vez)
   ════════════════════════════════════════════════════════════ */
:root {
  --fundo:        #0d0d0d;   /* cor de fundo — quase preto        */
  --fundo-rgb:    13,13,13;  /* mesma cor de fundo, em números (uso em transparências) */
  --painel:       #111;      /* fundo de painéis (menu celular, etc)  */
  --destaque:     #e07b39;   /* laranja âmbar — cor dos detalhes  */
  --destaque2:    #b85e25;   /* laranja escuro — usado no hover   */
  --texto:        #f0ece4;   /* texto principal — off-white morno */
  --texto2:       #8a8378;   /* texto secundário — cinza morno    */
  --borda:        #222;      /* linhas e bordas sutis             */

  /* FONTES */
  --titulo:   "dunbar-low", sans-serif;    /* títulos grandes       */
  --detalhe:  'LapisDeArtista', 'Caveat', cursive; /* rótulos, detalhes — caligrafia do Douglas */
  --corpo:    "dunbar-low", sans-serif;    /* textos corridos       */

  --transicao: 0.35s ease;
}

/* ── Modo claro — mesmas cores, invertidas ──
   Ativado via atributo data-tema="claro" na tag <html>, controlado
   pelo botão de alternância no rodapé (ver tema-toggle no rodapé de cada página) */
:root[data-tema="claro"] {
  --fundo:        #f0ece4;   /* era a cor do texto no modo escuro */
  --fundo-rgb:    240,236,228;
  --painel:       #e4dfd2;
  --texto:        #0d0d0d;   /* era a cor do fundo no modo escuro */
  --texto2:       #5c5c5c;   /* cinza neutro, mais escuro pra legibilidade */
  --borda:        #dcdcdc;
  /* --destaque e --destaque2 continuam os mesmos */
}

/* ── Reset básico (zera espaçamentos padrão do navegador) ── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  background: var(--fundo);
  color: var(--texto);
  font-family: var(--corpo);
  font-weight: 600;
  line-height: 1.7;
  overflow-x: hidden;
}
img { display: block; width: 100%; height: 100%; object-fit: cover; }
a   { color: inherit; text-decoration: none; }

/* ── Navegação (barra do topo) ── */
nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.6rem 3rem;
  background: linear-gradient(to bottom, rgba(var(--fundo-rgb),0.9), transparent);
  transition: background var(--transicao);
}
nav.rolada { background: rgba(var(--fundo-rgb),0.97); }

.nav-logo {
  font-family: 'LapisDeArtista', var(--detalhe);
  font-size: 2rem;
  letter-spacing: 0.06em;
  color: var(--texto);
  line-height: 1.2;
}
.nav-logo small {
  display: block;
  font-family: 'LapisDeArtista', var(--detalhe);
  font-size: 1.2rem;
  color: var(--destaque);
  letter-spacing: 0.2em;
  font-weight: 400;
}

.nav-links {
  display: flex;
  gap: 2.5rem;
  list-style: none;
}
.nav-links a {
  font-family: var(--detalhe);
  font-size: 1.5rem;
  color: var(--texto2);
  letter-spacing: 0.08em;
  transition: color var(--transicao);
  position: relative;
}
.nav-links a::after {
  content: '';
  position: absolute;
  bottom: -3px; left: 0;
  width: 0; height: 1px;
  background: var(--destaque);
  transition: width var(--transicao);
}
.nav-links a:hover,
.nav-links a.ativa { color: var(--destaque); }
.nav-links a:hover::after,
.nav-links a.ativa::after { width: 100%; }

/* menu hamburguer (celular) */
.nav-toggle {
  display: none;
  flex-direction: column;
  gap: 5px;
  cursor: pointer;
  background: none;
  border: none;
  padding: 4px;
  z-index: 101;
}
.nav-toggle span {
  display: block;
  width: 22px; height: 2px;
  background: var(--texto);
  transition: all var(--transicao);
}

/* ── Botões de tema/idioma sobre a foto da página inicial —
     ficam visíveis sem precisar rolar a página, na parte inferior central ── */
.hero-acoes {
  position: absolute;
  bottom: 2.6rem;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 0.6rem;
  z-index: 10;
}
.hero-acoes .tema-toggle {
  width: 132px;
  height: 44px;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  appearance: none;
  -webkit-appearance: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  text-align: center;
  color: #ffffff;
  border-color: rgba(255,255,255,0.5);
}
.hero-acoes .tema-toggle:hover {
  color: var(--destaque);
  border-color: var(--destaque);
}
@media (max-width: 768px) {
  .hero-acoes {
    bottom: 1.6rem;
    gap: 0.5rem;
  }
  .hero-acoes .tema-toggle {
    width: 112px;
    height: 40px;
    font-size: 0.7rem;
    padding: 0;
  }
}

/* ── Rodapé ── */
footer {
  padding: 2rem 3rem;
  border-top: 1px solid var(--borda);
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1rem;
}
footer span {
  font-size: 0.78rem;
  color: var(--texto2);
  opacity: 0.5;
}
.footer-logo {
  font-family: 'LapisDeArtista', var(--detalhe);
  font-size: 1.8rem;
  color: var(--texto2);
  opacity: 0.7 !important;
}

/* ── Agrupa os botões de tema e idioma no rodapé, lado a lado ── */
.footer-acoes {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  flex-wrap: wrap;
}

/* ── Alternância de tema (claro/escuro) e de idioma (PT/EN) — mesmo estilo de botão ── */
.tema-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 118px;
  height: 38px;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  appearance: none;
  -webkit-appearance: none;
  font-family: var(--detalhe);
  font-size: 0.78rem;
  line-height: 1;
  letter-spacing: 0.05em;
  text-align: center;
  color: var(--texto2);
  background: none;
  border: 1px solid var(--borda);
  cursor: pointer;
  transition: all var(--transicao);
}
.tema-toggle:hover {
  color: var(--destaque);
  border-color: var(--destaque);
}

/* ── Aviso de direitos autorais — linha fina abaixo do rodapé, em todas as páginas ── */
.aviso-direitos {
  padding: 0 3rem 1.6rem;
  font-size: 0.72rem;
  color: var(--texto2);
  opacity: 0.55;
  line-height: 1.6;
  max-width: 900px;
}
@media (max-width: 768px) {
  .aviso-direitos { padding: 0 1.5rem 1.3rem; text-align: center; max-width: none; }
}

/* ── Licença de uso — aparece junto das opções de compra no lightbox ── */
.lb-licenca {
  font-family: var(--detalhe);
  font-size: 0.72rem;
  color: var(--texto2);
  opacity: 0.6;
  line-height: 1.6;
  margin-top: 1.2rem;
  padding-top: 1rem;
  border-top: 1px solid var(--borda);
}

/* ── Animações de entrada ── */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(24px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

/* ── Reveal ao rolar a página ── */
.reveal {
  opacity: 0;
  transform: translateY(28px);
  transition: opacity 0.7s ease, transform 0.7s ease;
}
.reveal.visivel { opacity: 1; transform: translateY(0); }

/* ── Responsivo (celular) ── */
@media (max-width: 768px) {
  nav { padding: 1.2rem 1.5rem; }

  .nav-links {
    position: fixed;
    top: 0; right: -100%;
    height: 100vh;
    width: 72vw;
    max-width: 300px;
    background: var(--painel);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
    transition: right var(--transicao);
    border-left: 1px solid var(--borda);
  }
  .nav-links.aberto { right: 0; }
  .nav-links a { font-size: 1.8rem; }
  .nav-toggle { display: flex; }

  footer { flex-direction: column; text-align: center; padding: 1.5rem; }
}
